#!/usr/bin/env bash
# Trust pre-push gate. Install with `scripts/install-git-hooks.sh`.
#
# Trust has no CI, so this is the only thing between a drift class and `origin`.
#
# THIS HOOK DECLARES NO LANES. It runs exactly the rows carrying the `push`
# profile in `emit_gate_manifest` (tests/run_trust_comprehensive_harness.sh),
# fetched at run time via `--list push`. Until 2026-08-27 it hand-maintained its
# own list of eight ids, every one of which also existed in the manifest: two
# inventories that could only agree by eye. One of the eight, `fast.pr-gate`,
# was itself a bundle of ten checks behind one id, so a red inside it could only
# be quarantined by darkening all ten. Both duplications are gone; adding or
# removing a pre-push lane is now one word in one manifest row.
#
# One id per lane, wherever it runs, so one quarantine row governs it — which is
# why the push rows keep their `fast.`/`scoped.` ids rather than minting `push.*`
# twins. The `scoped.` prefix also carries the tier: those lanes run LAST here,
# because a 9-11 minute build ahead of a 200ms pin check is how a gate teaches
# people --no-verify.
#
# Lanes deliberately NOT in the push profile:
#
#   bridge REPLAY (`slow.bridge-replay`) — every bridged arm still carries its
#   kernel-checked agreement theorem. It kernel-checks 185 modules in ~142s.
#   Genuinely a different question from `fast.bridge-pin`, which proves the
#   artifacts BELONG to the pin: an artifact set can match its pin while a
#   theorem inside it has stopped checking, which is what happened 2026-07-25.
#
#   the rustc_mir_transform suite (`slow.mir-transform-ratchet`) — it is a BUILD
#   and takes scripts/trust_build_lock.sh, so it collided with the compiler-check
#   lane for that lock and produced two red lanes and zero defects. Only its
#   SELFTEST, which builds nothing, is in the push tier.
#
# WHY THE SLOW LANE IS HERE AT ALL. `scoped.compiler-check` runs
# `x.py check --stage 1` INCLUDING test targets, but only when the push touches
# compiler/, crates/, src/bootstrap/, targo-trust/ or a first-party gitlink, so a
# docs push pays nothing. It exists because every other push lane is a drift or
# pin check that compiles no compiler code, and `main` was broken three times on
# 2026-08-12/13 by pushes that never built the superproject — one of which also
# hid a dropped soundness check.
#
# A PUSH IS A BUILD for build-tree interlock purposes, and that is not obvious —
# it has bitten. Because that lane runs `x.py`, it takes the build-tree mutual
# exclusion lock like any other build, so a push attempted while a measurement
# sweep is in flight REFUSES here rather than deleting stage1/bin/rustc
# underneath it. The lock lives in x.py precisely so there is one place.
#
# PUSH CONTEXT. A manifest command string is fixed and gets no stdin, so the
# refs git hands us are EXPORTED as TRUST_PUSHED_REFS. FIVE lanes read it, each
# via its own `--push-context` mode: fast.revert-rationale,
# fast.measurement-provenance, fast.pin-regression, fast.dependency-constellation
# and fast.submodule-remote-reachability. With the variable unset the same rows
# widen to their history/`origin/main..HEAD`/index reading, so a `push` profile
# run outside this hook still works — and each prints a `SUBJECT:` line saying
# which reading it took, so the two are never confused.
#
# This count has been stale twice. It said "exactly three" while
# fast.dependency-constellation was already a fourth, and it kept saying three
# after fast.submodule-remote-reachability became a fifth on 2026-08-30. The
# enumeration is prose and nothing gates it, so treat the manifest as the
# authority: `bash tests/run_trust_comprehensive_harness.sh --list push` and
# grep the command strings for `--push-context`.
#
# WHY THE REACHABILITY LANE NEEDED IT (2026-08-30). It resolved its subject from
# the LOCAL INDEX, and the predicate it tests — "the pinned commit is contained
# in some fetched remote ref" — is satisfied MORE often by an OLDER pin. A clone
# that is behind therefore audited a systematically SAFER pin set than the one
# it was pushing. Measured that day on a clone 41 commits behind with 8 of 9
# first-party gitlinks differing: the lane audited the wrong 12 pins and printed
# PASS, while the pin set actually being published contained one reachable from
# a single deletable topic branch. A behind clone biasing a gate GREEN is the
# shape to look for whenever a lane reads the index.
#
# QUARANTINE, not bypass. A lane that is known-red gets a row in
# `tests/trust-comprehensive/divergences.toml` with an owner, a reason, and an
# `expires_on`. While that row is active the lane reports QUARANTINED and the
# push proceeds — and the moment the lane goes GREEN with the row still active,
# this hook FAILS and tells you to delete the row. A quarantine therefore cannot
# outlive the problem it documents, and the `fast.ledger-expirations` lane fails
# once it expires. There is no environment variable that turns a lane off; the
# escape hatch is `git push --no-verify`, which is git's and is visible in the
# reflog.
#
# Author: Andrew Yates <andrewyates.name@gmail.com>
# Copyright 2026 Andrew Yates | License: Apache-2.0 OR MIT
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: not inside a git worktree" >&2
  exit 1
}

# Git exports repository-local variables (notably GIT_DIR) while invoking a
# hook.  Leaving them set makes a nested `git -C first-party/<repo> ...`
# continue to inspect the superproject object store.  In a linked worktree that
# made both pin gates report every healthy sibling as unresolvable even though
# the same commands passed immediately outside the hook.  Resolve our root
# first, then let every subsequent Git command discover the repository named by
# its own working directory.
for git_local_var in $(git rev-parse --local-env-vars); do
  unset "$git_local_var"
done
cd "$REPO_ROOT"

# pre-push is fed "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on
# stdin. Read them all so git never sees EPIPE, and keep them:
# fast.revert-rationale judges exactly the commits this push would introduce.
PUSHED_REFS="$(cat 2>/dev/null || true)"

PYTHON_BIN=""
for candidate in python3.14 python3.13 python3.12 python3.11 python3 python; do
  if command -v "$candidate" >/dev/null 2>&1; then PYTHON_BIN="$candidate"; break; fi
done
if [ -z "$PYTHON_BIN" ]; then
  echo "pre-push: no python3 on PATH; cannot read the quarantine ledger" >&2
  exit 2
fi

LEDGER="tests/trust-comprehensive/divergences.toml"

# Prints the active, unexpired quarantine reason for a gate id, or nothing.
# Exits nonzero when the ledger itself is unreadable, which fails the push:
# an unreadable quarantine ledger means no lane's status can be trusted.
quarantine_for() {
  "$PYTHON_BIN" - "$LEDGER" "$1" <<'PY'
import sys
from datetime import date, datetime, timezone
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        print("no TOML parser available (need Python 3.11+ or tomli)", file=sys.stderr)
        raise SystemExit(2)

ledger, gate_id = Path(sys.argv[1]), sys.argv[2]
try:
    rows = tomllib.loads(ledger.read_text(encoding="utf-8")).get("divergences", [])
except Exception as exc:
    print(f"unreadable quarantine ledger {ledger}: {exc}", file=sys.stderr)
    raise SystemExit(2)

today = datetime.now(timezone.utc).date()
for row in rows:
    if not isinstance(row, dict) or row.get("gate_id") != gate_id:
        continue
    if str(row.get("status", "")).lower() != "active":
        continue
    expires = row.get("expires_on")
    if isinstance(expires, str):
        expires = date.fromisoformat(expires)
    if not isinstance(expires, date) or expires < today:
        continue
    print(f"{row.get('id')} :: expires {expires} :: {row.get('required_action', '')}")
    break
PY
}

FAILED=0
run_lane() {
  local gate_id="$1"
  local command="$2"
  local quarantine
  if ! quarantine="$(quarantine_for "$gate_id")"; then
    echo "pre-push: cannot read $LEDGER — refusing to judge any lane" >&2
    exit 2
  fi

  echo
  echo "=== $gate_id ==="
  # Same exec form as the harness's run_gate, so one command string cannot mean
  # two things. </dev/null: a lane must not eat the lane list off our stdin.
  if ( cd "$REPO_ROOT" && bash -o pipefail -c "$command" ) </dev/null; then
    if [ -n "$quarantine" ]; then
      echo "FAIL: $gate_id is GREEN but still quarantined."
      echo "      Delete the row and push again: $quarantine"
      FAILED=1
    else
      echo "PASS: $gate_id"
    fi
    return
  fi

  if [ -n "$quarantine" ]; then
    echo "QUARANTINED: $gate_id is red under an active, unexpired ledger row."
    echo "             $quarantine"
    return
  fi
  echo "FAIL: $gate_id"
  FAILED=1
}

echo "Trust pre-push gate (no stage2 build required)"

# THE MANIFEST IS THE INVENTORY, and this hook is not a second copy of it.
HARNESS="tests/run_trust_comprehensive_harness.sh"
if ! LANES="$(bash "$HARNESS" --list push)"; then
  echo "pre-push: \`$HARNESS --list push\` failed — refusing to push with an unknown lane set" >&2
  exit 2
fi
if [ -z "$LANES" ]; then
  echo "pre-push: the push profile is EMPTY — a gate with no lanes is not a green gate." >&2
  exit 2
fi

# EXPORTED, not piped: the command string must be byte-identical wherever it
# runs, and this loop's own stdin is already the lane list.
export TRUST_PUSHED_REFS="$PUSHED_REFS"

# Manifest order is execution order; `scoped.*` is deferred to the end.
SCOPED=()
while IFS=$'\t' read -r gate_id _category _required _last_green command; do
  [ -n "$gate_id" ] || continue
  case "$gate_id" in
    scoped.*) SCOPED+=("$gate_id"$'\t'"$command"); continue ;;
  esac
  run_lane "$gate_id" "$command"
done <<< "$LANES"
# bash 3.2 (what /usr/bin/env bash resolves to here) errors on "${A[@]}" for an
# empty array under `set -u`.
for entry in ${SCOPED+"${SCOPED[@]}"}; do
  run_lane "${entry%%$'\t'*}" "${entry#*$'\t'}"
done

echo
if [ "$FAILED" -eq 0 ]; then
  echo "PRE-PUSH: GREEN"
  exit 0
fi
echo "PRE-PUSH: RED — fix the lanes above, or quarantine one with an owned,"
echo "expiring row in $LEDGER. \`git push --no-verify\` skips this hook and"
echo "leaves no record of why."
exit 1
