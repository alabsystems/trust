#!/usr/bin/env bash
# Trust PIN-ONLY pre-push hook — the narrow gate.
#
# Author: Andrew Yates. Copyright 2026 Andrew Yates. License: Apache-2.0 OR MIT.
#
# WHY THIS EXISTS SEPARATELY FROM scripts/hooks/pre-push
# ------------------------------------------------------
# `core.hooksPath` is all-or-nothing: it names ONE directory, and every hook in
# it fires. So "turn on the pin gate" and "turn on the full pre-push gate" were
# the same switch, and the full gate is not a switch a single lane may flip on a
# shared machine. Measured 2026-08-13 at 352aa0306d:
#
#   fast.pr-gate            11.60s   GREEN  (that id was RETIRED 2026-08-27 —
#                                    the bundle became ten individually
#                                    quarantinable rows; the 11.60s stands as
#                                    the measurement of the bundle it named)
#   fast.pin-coherence       0.49s   RED (first-party/trust-cg, first-party/trust-vc)
#   fast.bridge-pin          0.44s   GREEN
#   scoped.compiler-check   `python3 x.py check --stage 1`, self-documented
#                           ~9-11 min, fires whenever the pushed diff touches
#                           compiler/ crates/ src/bootstrap/ targo-trust/ or
#                           first-party/ — 32 of the last 60 commits on main
#                           (53.3%) touch those paths.
#
# and `tests/trust-comprehensive/divergences.toml` has NO row for
# `fast.pin-coherence`, so that RED is not quarantined. Installing the full
# hooks directory today would therefore have blocked every push from every lane
# on this machine on a condition none of them caused, whose only remedy is
# moving two DIVERGENT submodule pointers that the standing safety rules forbid
# anyone to move. That is how a gate teaches people `--no-verify`.
#
# This directory is the pin gate WITHOUT that blast radius. It runs eight
# checkers and nothing else — `scripts/check_pin_coherence.sh` (0.49s measured),
# `scripts/check_revert_rationale.sh` (0.49s measured over the whole
# 7,089-commit history), `scripts/check_frozen_files.sh`,
# `scripts/check_measurement_provenance.sh` (0.95s measured over 7,112 commits
# in the wider --history mode), `scripts/check_bridge_pin.sh --check` (0.23s
# measured), `scripts/check_ir_cohort.py` (0.84s measured, added 2026-08-27),
# `scripts/check_submodule_remote_reachability.py`, and
# `scripts/check_cfg_test_caller_skew.py` (added 2026-09-01, the only SOURCE
# checker here) — for a combined budget of about four seconds. (This paragraph
# said "six" and omitted the reachability lane until 2026-09-01;
# `install-pin-hook.sh` said "check_pin_coherence.sh only", so three sources
# carried three different counts — 1, 6 and 7 — and an agent debugging a red
# `check_ir_cohort.py` could read that it does not run. If you add a ninth,
# change this number in the same edit.) No x.py, no build of any kind,
# and NOT the gate manifest's `push` profile: this list is hand-maintained here
# on purpose, because the point of this directory is a fixed small blast radius
# that does not grow when someone adds a row. scripts/hooks/pre-push is the one
# that derives its lanes; folding this one in is a separate change.
#
# "No bridge REPLAY" still holds and is the distinction to keep straight: the
# replay kernel-checks 185 modules and takes ~142s, which is exactly the kind of
# lane this directory refuses. `check_bridge_pin.sh --check` runs none of it —
# it compares the indexed gitlinks against the indexed manifest and exits.
#
# THE SECOND CHECKER, and why it is here rather than in the full gate: on
# 2026-08-20 `31814afa35` reverted `8e214e90d5`, the wave-SG struct-interior
# offset gate — a CONFIRMED miscompile mechanism — with a commit body that was
# the generated "This reverts commit ..." line and nothing else. No reason in
# the message, in a report, in a lane note, or in a commit comment. The class
# was ungated again for 2h10m and came back only because another lane
# independently re-derived the evidence. The revert was probably CORRECT (that
# tree's `--lib` suite was red); the silence is what cost the hours. This is
# the hook that is actually installed on the machines that push, so this is
# where the requirement has to live. A commit-msg hook would be earlier and
# would catch nothing: these lanes land through `git commit-tree`, which runs
# no commit-msg hook at all.
#
# BLOCKING, not advisory — and why that is safe here
# --------------------------------------------------
# An advisory pin notice already exists (the post-merge/post-rewrite/post-checkout
# hooks beside this file) and advisory is the right shape at pull time, when the
# drift is created and the operation is not the lane's fault. Push is the last
# moment before drift becomes everyone's, so this one blocks.
#
# It is safe to block because the verdict is scoped per submodule, not per repo:
# a path listed in `pin-waivers.txt` with an unexpired date is reported and
# stepped over, so PRE-EXISTING drift someone else owns cannot hold your push
# hostage, while any NEW drift blocks immediately. That is the whole recurrence
# class. Mirroring the quarantine philosophy of scripts/hooks/pre-push, a waiver
# that has become unnecessary FAILS the push and asks to be deleted, so it
# cannot outlive the problem it documents, and an expired waiver stops applying.
#
# NEVER MUTATES. This hook does not run `git submodule update`, does not check
# anything out, and does not move a pointer. It reads and reports. Restoring a
# worktree is a deliberate act (`scripts/submodule_sync.sh`), never a side
# effect of a push.
#
# Escape hatch is git's own: `git push --no-verify`, which shows up in the
# reflog rather than in a habit. There is no environment variable.
set -uo pipefail

# pre-push is fed "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on
# stdin. Read every one of them so git never sees EPIPE — and KEEP them: the
# PIN verdict does not depend on which refs are being pushed (an incoherent pin
# is incoherent for all of them), but the revert-rationale lane judges exactly
# the commits this push would introduce, so discarding the lines would cost it
# its subject.
PUSHED_REFS="$(cat 2>/dev/null || true)"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pin-hook: not inside a git worktree" >&2
  exit 1
}

# Git exports repository-local variables (notably GIT_DIR) while running a hook.
# Leaving them set makes every nested `git -C first-party/<repo> ...` inside the
# checker inspect the SUPERPROJECT object store instead, which reports healthy
# siblings as unresolvable. scripts/hooks/pre-push learned this the hard way in
# a linked worktree; the same unset is mandatory here.
for git_local_var in $(git rev-parse --local-env-vars); do
  unset "$git_local_var"
done
cd "$REPO_ROOT" || exit 1

# ------------------------------------------------------- lane: revert rationale
# Judged on exactly the commits this push would introduce. Fails CLOSED: a
# missing checker is a state in which a revert could land unexplained, which is
# the whole failure this lane exists to end, so it is a refusal and not a shrug.
REVERT_CHECKER="scripts/check_revert_rationale.sh"
if [ -f "$REVERT_CHECKER" ]; then
  revert_out="$(printf '%s\n' "$PUSHED_REFS" | bash "$REVERT_CHECKER" --pre-push 2>&1)"
  revert_rc=$?
else
  revert_out="pin-hook: $REVERT_CHECKER is missing — a revert could land with no reason recorded"
  revert_rc=1
fi

# --------------------------------------------------- lane: measurement provenance
# Same subject as the revert lane (the commits this push introduces) and the
# same cost class: one `git log` over the range plus one `git rev-parse` per
# trailer. Measured 2026-08-20 at 0.95s over the whole 7,112-commit history in
# --history mode; a push range is a handful of commits.
#
# WHY IT IS HERE. On 2026-08-19 a lane published "599 passed, 0 failed" — a real
# run — of a tree it had edited and never committed. The commit body described
# the WORKING TREE rather than the COMMIT, `8e214e90d5` was RED at exactly one
# test, and a confirmed-miscompile-class gate was reverted on the strength of
# that number. The RCA (reports/revert-silence-rca-2026-08-20.md) called the fix
# "a lane-runner convention, not something a pre-push hook can enforce". It is
# enforceable, and this is where: a `Measured-on: <path>@<blob>` trailer is a
# claim about a blob, and a claim about a blob is checkable against the commit
# that carries it. A stamp that names a tree the commit does not carry is a
# refused push.
#
# Fails CLOSED for the same reason the revert lane does: a missing checker is a
# state in which an unfounded number could land, which is the whole failure.
PROV_CHECKER="scripts/check_measurement_provenance.sh"
if [ -f "$PROV_CHECKER" ]; then
  prov_out="$(printf '%s\n' "$PUSHED_REFS" | bash "$PROV_CHECKER" --pre-push 2>&1)"
  prov_rc=$?
else
  prov_out="pin-hook: $PROV_CHECKER is missing — a measurement could land naming no tree"
  prov_rc=1
fi

CHECKER="scripts/check_pin_coherence.sh"
WAIVERS="scripts/hooks-pin/pin-waivers.txt"

if [ ! -f "$CHECKER" ]; then
  echo "pin-hook: $CHECKER is missing — refusing to certify pins" >&2
  exit 1
fi

out="$(bash "$CHECKER" 2>&1)"
rc=$?

TODAY="$(date -u +%Y-%m-%d)"

# ---------------------------------------------------------------- waiver table
# Format, one row per line, `|`-separated:
#     <submodule path> | <expires YYYY-MM-DD> | <owner> | <reason>
# Blank lines and lines whose first non-space character is `#` are comments.
W_PATH=()
W_EXPIRES=()
W_OWNER=()
W_REASON=()
if [ -f "$WAIVERS" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    # Strip leading whitespace, then judge the FIRST character. (A `#` anywhere
    # else is ordinary text: reasons routinely contain issue numbers.)
    lead="${line%%[![:space:]]*}"
    trimmed="${line#"$lead"}"
    case "$trimmed" in
      ''|'#'*) continue ;;
    esac
    case "$line" in
      *'|'*) ;;
      *) continue ;;
    esac
    w_path="$(printf '%s' "$line" | awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); print $1}')"
    w_exp="$(printf '%s' "$line" | awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2}')"
    w_own="$(printf '%s' "$line" | awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/,"",$3); print $3}')"
    w_rea="$(printf '%s' "$line" | awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/,"",$4); print $4}')"
    [ -z "$w_path" ] && continue
    W_PATH[${#W_PATH[@]}]="$w_path"
    W_EXPIRES[${#W_EXPIRES[@]}]="$w_exp"
    W_OWNER[${#W_OWNER[@]}]="$w_own"
    W_REASON[${#W_REASON[@]}]="$w_rea"
  done < "$WAIVERS"
fi

# Index of the waiver row for a path, or -1. ISO-8601 dates compare correctly as
# strings, so no date arithmetic (and no python) is needed.
waiver_index() {
  local want="$1" i=0
  while [ "$i" -lt "${#W_PATH[@]}" ]; do
    if [ "${W_PATH[$i]}" = "$want" ]; then printf '%s' "$i"; return 0; fi
    i=$((i + 1))
  done
  printf '%s' "-1"
}

# ------------------------------------------------------- classify the findings
BLOCKING=()
STEPPED_OVER=()
STALE_WAIVERS=()
PROBLEM_ROWS=0

while IFS= read -r row; do
  case "$row" in
    '  - '*) ;;
    *) continue ;;
  esac
  PROBLEM_ROWS=$((PROBLEM_ROWS + 1))
  kind="$(printf '%s' "$row" | awk '{print $2}')"
  path="$(printf '%s' "$row" | awk '{print $3}')"
  finding="${row#  - }"
  idx="$(waiver_index "$path")"
  if [ "$idx" = "-1" ]; then
    BLOCKING[${#BLOCKING[@]}]="$finding"
    continue
  fi
  exp="${W_EXPIRES[$idx]}"
  if [ -z "$exp" ] || [[ "$exp" < "$TODAY" ]]; then
    BLOCKING[${#BLOCKING[@]}]="$finding
      waiver for $path EXPIRED on ${exp:-<no date>} (owner ${W_OWNER[$idx]}) — it no longer applies"
    continue
  fi
  STEPPED_OVER[${#STEPPED_OVER[@]}]="$kind $path  waived until $exp by ${W_OWNER[$idx]} :: ${W_REASON[$idx]}"
done <<<"$out"

# A waiver whose subject is coherent again is dead weight that silently widens
# the gate. Same rule scripts/hooks/pre-push applies to quarantine rows: GREEN
# under an active waiver FAILS, and the fix is to delete one line.
i=0
while [ "$i" -lt "${#W_PATH[@]}" ]; do
  wp="${W_PATH[$i]}"
  we="${W_EXPIRES[$i]}"
  if [ -n "$we" ] && [[ ! "$we" < "$TODAY" ]]; then
    case "$out" in
      *"ok  $wp  @"*)
        STALE_WAIVERS[${#STALE_WAIVERS[@]}]="$wp is at its recorded pin again — delete its line from $WAIVERS"
        ;;
    esac
  fi
  i=$((i + 1))
done

# The checker failed but produced nothing we recognise as a finding: fail closed
# rather than guess. A checker whose output we cannot read is not a green one.
if [ "$rc" -ne 0 ] && [ "$PROBLEM_ROWS" -eq 0 ]; then
  echo "pin-hook: $CHECKER exited $rc with no parseable finding — failing closed." >&2
  printf '%s\n' "$out" >&2
  exit 1
fi

# ------------------------------------------------------------------ the report
printf '%s\n' "$revert_out"
echo
printf '%s\n' "$prov_out"
echo
echo "=== pin-coherence (pin-only hook; no bridge replay, no x.py, not the push profile) ==="

if [ "${#STEPPED_OVER[@]}" -gt 0 ]; then
  echo
  echo "WAIVED — pre-existing drift this push did not cause:"
  for s in "${STEPPED_OVER[@]}"; do echo "  ~ $s"; done
fi

PIN_RC=0
if [ "${#BLOCKING[@]}" -eq 0 ] && [ "${#STALE_WAIVERS[@]}" -eq 0 ]; then
  echo
  echo "PIN GATE: GREEN — no unwaived submodule pin drift."
else
  PIN_RC=1
fi

if [ "${#STALE_WAIVERS[@]}" -gt 0 ]; then
  echo
  echo "FAIL: a pin waiver is no longer needed."
  for s in "${STALE_WAIVERS[@]}"; do echo "  x $s"; done
fi

if [ "${#BLOCKING[@]}" -gt 0 ]; then
  echo
  echo "FAIL: submodule pin drift that nothing waives."
  for b in "${BLOCKING[@]}"; do echo "  x $b"; done
  echo
  echo "This hook never moves a pointer. Classify the drift first —"
  echo "BEHIND is restorable, AHEAD holds commits the pin does not:"
  echo
  echo "    scripts/submodule_sync.sh              # classify (read-only)"
  echo "    scripts/submodule_sync.sh --restore    # BEHIND, plus AHEAD/DIVERGENT"
  echo "                                           # whose every unique commit is"
  echo "                                           # held by a durable ref (ANCHORED)"
  echo
  echo "Do NOT run a blanket 'git submodule update'. If the drift is someone"
  echo "else's and genuinely not yours to resolve, add an owned, expiring row to"
  echo "    $WAIVERS"
fi

if [ "$PIN_RC" -ne 0 ]; then
  echo
  echo "PIN GATE: RED."
fi

# ==========================================================================
# LANE 3 — THE ORACLE FREEZE (added 2026-08-20)
# ==========================================================================
# Why a THIRD lane belongs in the file whose header argues for exactly one:
#
#   * It costs the same order as the pin lane — four `git hash-object` and four
#     `git rev-parse`, no build, no cargo, no x.py, no network.
#   * It NEVER MUTATES, which is this file's other standing property.
#   * It carries the same waiver shape, so pre-existing movement someone else
#     owns cannot hold a push hostage, while NEW movement blocks immediately.
#     That is the whole recurrence class this hook was written for.
#
# And it cannot wait for the full `scripts/hooks/pre-push`: by this file's own
# header that directory is not installed here and must not be, so "the oracle
# freeze is enforced at push time" and "the full gate is installed" would
# otherwise be the same switch — which is exactly the coupling this file exists
# to break.
#
# The defect it closes, MEASURED 2026-08-20: three commits (e73d7d0553,
# 5b38ded9d9, 65f2577dca) moved two of the four frozen oracle files with nothing
# recorded anywhere. All three were adjudicated legitimate on their merits, which
# is the point — a freeze that fires only when a lane remembers it cannot
# distinguish the three good commits from the one it exists to catch, because it
# does not fire at all. See reports/freeze-adjudication-2026-08-20.md.
FREEZE_CHECKER="scripts/check_frozen_files.sh"
FREEZE_RC=0
echo
if [ -f "$FREEZE_CHECKER" ]; then
  bash "$FREEZE_CHECKER" || FREEZE_RC=1
else
  echo "freeze-gate: $FREEZE_CHECKER is missing — refusing to certify the oracle freeze." >&2
  FREEZE_RC=1
fi


# ==========================================================================
# LANE 4 — THE OLEAN BRIDGE PROVENANCE (added 2026-08-26)
# ==========================================================================
# The Lean<->Clean bridge replays against VENDORED .olean artifacts, and both
# halves of that replay are pinned submodules: `first-party/trust-ir` supplies
# the Lean semantics the artifacts were built from, `first-party/clean` the
# reader that decodes them and the kernel that admits them. When a gitlink moves
# without its manifest, the bridge replays ONE revision's bytes under ANOTHER
# revision's recorded identity, and the provenance it prints is false.
#
# WHY LANE 1 DOES NOT COVER THIS, which is the whole reason for a fourth lane:
# pin coherence compares the gitlink against the CHECKOUT. Those two agree
# throughout this failure — it is the MANIFEST that disagrees with both, and
# nothing in lanes 1-3 reads it. Pin coherence was green for every occurrence
# below.
#
# MEASURED, four occurrences, all from commits about something else entirely:
#   3e9efe9aac  "measure: the composition ceiling is a CORPUS property"
#   2ce0f586ee  (clean gitlink, during trustir_adt work)
#   94d5cb9493 / edb9472dd1  "prove: key the opaque environment by (parameter, PART)"
# Each carried a stale-or-fresh submodule worktree into the index as collateral.
# Repaired by hand each time (aa33903220, e32e588dac, 32e25e21ab); the header of
# `check_bridge_pin.sh` records ~10 more before that.
#
# It belongs in the NARROW set by this file's own admission test: 228 ms
# measured, no build, no cargo, no x.py, no network, and it NEVER MUTATES —
# `--check` only compares the index against the indexed manifest. The mutating
# repair is `--fix`, which this hook does not call.
#
# No waiver table: unlike a submodule pin, there is no such thing as
# legitimately-drifted bridge provenance that someone else owns. The manifest
# either names the revision being replayed or it is wrong, and `--fix`
# regenerates it in one command.
BRIDGE_CHECKER="scripts/check_bridge_pin.sh"
BRIDGE_RC=0
echo
if [ -f "$BRIDGE_CHECKER" ]; then
  bash "$BRIDGE_CHECKER" --check || BRIDGE_RC=1
else
  echo "bridge-pin: $BRIDGE_CHECKER is missing — refusing to certify bridge provenance." >&2
  BRIDGE_RC=1
fi

# THE SIXTH CHECKER: cohort IR semantics (M0).
#
# The five checkers above are all about GITLINKS. But the cohort consumes
# trust-ir through cargo git dependencies, and until 2026-08-27 no gate here had
# ever read one. The first run found 24 declarations spread over 6 revisions and
# FIVE distinct semantic surfaces, every one of them reporting wire version 37 —
# the version number is a decoding floor, not an agreement about meaning.
#
# It belongs in THIS directory rather than the full gate for the same reason as
# the rest: it is git plumbing only. Measured 0.84s wall, no build, no network.
COHORT_CHECKER="scripts/check_ir_cohort.py"
COHORT_RC=0
echo
if [ -f "$COHORT_CHECKER" ]; then
  python3 "$COHORT_CHECKER" || COHORT_RC=1
else
  echo "ir-cohort: $COHORT_CHECKER is missing — refusing to certify IR semantics." >&2
  COHORT_RC=1
fi

# ------------------------------------------- lane: submodule remote reachability
# MEASURED COST OF ITS ABSENCE (2026-08-30 audit of all 1,500 gitlink values ever
# recorded on main): 22 pins name commits that exist on NO remote and in none of
# 873 local object stores, nor in staging or release (44 probes, 44 "not our
# ref"). They are unrecoverable, and because a pin stays live until the next
# bump, 169 superproject commits — 2.12% of main — cannot be reproduced at their
# recorded sibling revision.
#
# The cause is a machine landing a superproject gitlink whose sibling commit was
# never pushed. check_pin_coherence.sh above CANNOT catch it: it asks whether a
# pin resolves LOCALLY, which is true by construction on precisely the machine
# that authored the unpushed commit. This checker asks the remote instead.
#
# It belongs in THIS directory by the same rule as the rest — git plumbing only,
# no build, no build-tree lock. Measured 2.2s wall on a 12-pin clone, inside the
# directory's budget. It reads TRUST_PUSHED_REFS so it judges the revisions
# actually being published rather than the index (a behind clone otherwise
# audits an older, systematically safer pin set and prints PASS).
REACH_CHECKER="scripts/check_submodule_remote_reachability.py"
REACH_RC=0
echo
if [ -f "$REACH_CHECKER" ]; then
  TRUST_PUSHED_REFS="$PUSHED_REFS" python3 "$REACH_CHECKER" --push-context || REACH_RC=1
else
  echo "pin-hook: $REACH_CHECKER is missing — a gitlink could land naming a commit no one else can fetch"
  REACH_RC=1
fi

# ------------------------------------------------- lane: cfg(test) caller skew
# THE EIGHTH CHECKER, and the first one in this directory that is about SOURCE
# rather than about gitlinks.
#
# Everything above this line is a pin, a freeze or a message check. That is the
# whole design of this directory — and it means a clone that installs it, which
# is what the repo tells shared machines to do, has NOTHING between a source
# break and `origin`. The full set's `scoped.compiler-check` is the only lane
# anywhere that type-checks a `crates/**` TEST target, and by this file's own
# header that set is not installed here and must not be.
#
# MEASURED COST OF THAT GAP, twice in eighteen hours, same crate, same producer:
#   d26cb8c40e  E0063 — `PendingConst::promoted_global` reached every production
#               construction site and missed the `#[cfg(test)]` one. Repaired by
#               cf89d447db, whose own body blamed the SCOPE filter; that reading
#               was wrong — d26cb8c40e touches `crates/`, so it was in scope.
#   78a0bef5ff  E0061 — seven taint walkers widened, both production callers
#               updated, 45 `#[cfg(test)]` call sites left at the old arity.
#               Still red on origin/main at ad074447848d29974bec329d7e3587bb92dc4d38.
# Both trees BUILT. `x.py build` and `x.py test tests/ui` compile lib targets and
# a `#[cfg(test)]` body is not in a lib target, so no amount of care in the
# producer's measurement loop can surface this class.
#
# It belongs in the NARROW set by this file's own admission test: it reads the
# blobs in the pushed range with `git show` and nothing else — no build, no
# cargo, no x.py, no network, no build-tree lock — and it NEVER MUTATES.
# Measured under a second on a producer-sized push. It judges only definitions
# the pushed range CHANGED and declines rather than guesses, so it is quiet:
# over the 300 single-commit ranges ending at ad07444784 it names the two
# commits above and nothing else.
#
# It is NOT a type checker and does not retire `scoped.compiler-check`, which
# remains the authority. It exists so that the authority is not the only thing
# standing between this class and `main`.
SKEW_CHECKER="scripts/check_cfg_test_caller_skew.py"
SKEW_RC=0
echo
if [ -f "$SKEW_CHECKER" ]; then
  TRUST_PUSHED_REFS="$PUSHED_REFS" python3 "$SKEW_CHECKER" --push-context || SKEW_RC=1
else
  echo "cfg-test-skew: $SKEW_CHECKER is missing — a signature change could land"
  echo "               with its #[cfg(test)] construction sites behind it."
  SKEW_RC=1
fi

if [ "$PIN_RC" -eq 0 ] && [ "$FREEZE_RC" -eq 0 ] && [ "$revert_rc" -eq 0 ] && [ "$prov_rc" -eq 0 ] && [ "$BRIDGE_RC" -eq 0 ] && [ "$COHORT_RC" -eq 0 ] && [ "$REACH_RC" -eq 0 ] && [ "$SKEW_RC" -eq 0 ]; then
  exit 0
fi

echo
echo "PRE-PUSH: RED (pin=$PIN_RC freeze=$FREEZE_RC revert=$revert_rc provenance=$prov_rc bridge=$BRIDGE_RC cohort=$COHORT_RC reach=$REACH_RC skew=$SKEW_RC)."
if [ "$SKEW_RC" -ne 0 ]; then
  echo "  skew: a definition this push changes has a construction site that did not"
  echo "        follow it. Under #[cfg(test)] no lib build can see this — it is a"
  echo "        real compile error that lands green and is paid for by the next lane."
fi
if [ "$REACH_RC" -ne 0 ]; then
  echo "  reach: a submodule pin above names a commit no remote can serve."
  echo "         push the sibling repo first, or anchor it:"
  echo "         scripts/audit_first_party_pins.py --anchor"
fi
if [ "$COHORT_RC" -ne 0 ]; then
  echo "  cohort: consumers disagree about what a trust-ir module MEANS."
  echo "          inventory with: scripts/check_ir_cohort.py --report"
  echo "          a divergence you do not own gets an expiring, owned row in"
  echo "          scripts/hooks-pin/ir-cohort-waivers.txt — never a unilateral pin bump."
fi
if [ "$BRIDGE_RC" -ne 0 ]; then
  echo "  bridge: the olean manifest does not name the revision it replays."
  echo "          repair with: scripts/check_bridge_pin.sh --fix"
fi
# Exit 2 from either lane means "I could not do my job", NOT "I found a
# problem" — most often a range whose remote side is not in this object store
# because the remote advanced and nothing has fetched it yet. Saying "a revert
# does not say WHY" in that state names the wrong defect and sends the reader
# to rewrite a commit message that was never the problem. Measured 2026-08-26:
# that exact misdiagnosis cost a multi-minute hunt while the real cause —
# `git log <unfetched-sha>..HEAD failed` — was printed at the TOP of the output
# and scrolled off. Distinguish the two.
if [ "$revert_rc" -eq 2 ]; then
  echo "  revert: the checker could NOT READ the range (see its message above)."
  echo "          usually an unfetched remote sha: git fetch, rebase, retry."
elif [ "$revert_rc" -ne 0 ]; then
  echo "  revert: a revert above does not say WHY."
fi
if [ "$prov_rc" -eq 2 ]; then
  echo "  provenance: the checker could NOT READ the range (see its message above)."
  echo "              usually an unfetched remote sha: git fetch, rebase, retry."
elif [ "$prov_rc" -ne 0 ]; then
  echo "  provenance: a measurement above does not name the tree it was taken on."
fi
echo "'git push --no-verify' skips this hook and leaves no record of why."
exit 1
