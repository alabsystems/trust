; HAND-WRITTEN by the Part A-Lean reviewer: what a producer SHOULD emit for the scalar probes the
; standalone Lean lane refuses (p01 p02 p12b p13 p14 p15 p18 p20). One function per refused Lean def.
; TrustIr text format v1
module "parta-lean-should-emit"

functy.0 = (u64, u64) -> (bool)

functy.1 = (u64, u64) -> (u64)

functy.2 = (u64) -> (u64)

functy.3 = () -> (u8)

functy.4 = (u8) -> (u64)

functy.5 = (u64, u64, u64) -> (bool)

rustcc fn @isLt(functy.0) {
    ; #producer: clean
bb0(%0: u64, %1: u64):
    %2 = icmp ult u64 %0, %1
    ret %2
}

rustcc fn @min2(functy.1) {
    ; #producer: clean
bb0(%0: u64, %1: u64):
    %2 = icmp ult u64 %0, %1
    %3 = select u64 %2, %0, %1
    ret %3
}

rustcc fn @quot(functy.1) {
    ; #producer: clean
bb0(%0: u64, %1: u64):
    %2 = const u64 0
    %3 = icmp eq u64 %1, %2
    condbr %3, bb1, bb2
bb1:
    ret %2
bb2:
    %4 = udiv u64 %0, %1
    ret %4
}

rustcc fn @inc(functy.2) {
    ; #producer: clean
bb0(%0: u64):
    %1 = const u64 1
    %2 = add u64 %0, %1
    ret %2
}

rustcc fn @inc2(functy.2) {
    ; #producer: clean
bb0(%0: u64):
    %1 = call @func.3(%0)
    %2 = call @func.3(%1)
    ret %2
}

rustcc fn @mask(functy.1) {
    ; #producer: clean
bb0(%0: u64, %1: u64):
    %2 = and u64 %0, %1
    %3 = const u64 1
    %4 = or u64 %2, %3
    ret %4
}

rustcc fn @lit300(functy.3) {
    ; #producer: clean
bb0:
    %0 = const u8 44
    ret %0
}

rustcc fn @widen(functy.4) {
    ; #producer: clean
bb0(%0: u8):
    %1 = zext u8 %0 to u64
    ret %1
}

rustcc fn @both(functy.5) {
    ; #producer: clean
bb0(%0: u64, %1: u64, %2: u64):
    %3 = icmp ult u64 %0, %1
    %4 = icmp ult u64 %1, %2
    %5 = and bool %3, %4
    ret %5
}
