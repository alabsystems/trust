LL | /     def and_isl (c e : Bool) : Bool := c && e
LL | |     def and3_isl (s i n : Bool) : Bool := s && i && n
LL | |     def lt_or_eq_isl (a b : UInt8) : Bool := decide (a < b) || a == b
LL | |     def gate_isl (w c e : Bool) : Bool := w && (c || !e)
LL | |     def ord_isl (a b c : Bool) : Bool := (!a && b) || c
LL | |     def bit_isl (a b : UInt8) : Bool := decide (a &&& b = 0) || decide (a < b)
LL | |     def comp_isl (a b : Bool) (x : UInt8) : Bool := decide ((if a = true then x else 0) < 5) || b
