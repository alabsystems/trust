crates/target/
# Trust: the same Spotlight layout for the crates workspace: `crates/target` may be
# a symlink to `crates/target.noindex` (scripts/reclaim_incremental.py walks it).
# `crates/target/` above has a trailing slash, so it does NOT match that symlink;
# these two lines do. Committed so the checkout needs no local info/exclude rule,
# which `targo trust release validate` refuses as non-commit-bound ignore authority.
/crates/target
/crates/target.noindex
# The feature-gated test lane's own target dir (scripts/feature_gated_tests.py,
# harness rows slow.feature-gated-tests-*): kept apart from crates/target so the
# slow lane never contends with a push lane's build.
/crates/target-feature-gated.noindex/
# The native registrar owns the compiler target; logs must not pre-create it.
/crates/target-feature-gated-build.noindex/
/crates/target-feature-gated-logs.noindex/
# Scoped feature integration tests can also build package binaries; keep those
# outputs separate from the default-feature binaries recorded by the same gate.
/crates/target-scoped-feature-tests.noindex/
# Generated by direct Cargo operations in this rustc_private standalone crate;
# the canonical Trust workspace lockfile is crates/Cargo.lock.
/crates/trust-mir-extract/Cargo.lock
examples/**/target/
third_party/*/target/
third_party/*/Cargo.lock
trustdoc-ice-*.txt

# Trust stage0 local build caches and dated dry-run dist directories.
/bootstrap/trust-stage0/artifacts/
/bootstrap/trust-stage0/artifacts-with-llvm-assertions/
/bootstrap/trust-stage0/dist/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
!/bootstrap/trust-stage0/dist/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
!/bootstrap/trust-stage0/dist/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/channel-rust-trust.toml
!/bootstrap/trust-stage0/dist/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/channel-rust-trust.toml.sha256

# Trust stage0 distribution payloads are generated release artifacts.
# Keep channel manifests and checksums in Git; upload archives to artifact storage.
/bootstrap/trust-stage0/dist/**/*.tar
/bootstrap/trust-stage0/dist/**/*.tar.gz
/bootstrap/trust-stage0/dist/**/*.tar.xz

