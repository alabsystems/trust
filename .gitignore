# Build-tree mutual exclusion lock (scripts/trust_build_lock.sh) and the advisory
# measurement sentinel it backs. Runtime state about THIS machine's tree, never
# content: a committed lock would refuse builds in every clone that pulled it.
/.trust-build-lock/
/.trust-build-lock.*
/.trust-measurement-in-flight
# The landing gate's private lock copies (scripts/land_gate.py,
# unused_order_answer): a directory of links beside a workspace that a killed
# gate can leave; the next gate removes it. Never content.
.trust-land-unused-order.*/

