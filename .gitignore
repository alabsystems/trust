/tcargo-trust/
/src/tools/cargo/
tests/trust-falsification/[0-9]*/
tests/trust-falsification/*.mir

# Transient inline-snapshot review journals written by insta. Accepted
# snapshots live in their source files; pending journals must never be tracked.
*.pending-snap
/install/

# Externally generated dependency-constellation evidence.  The terminal
# TrustWP/Trust cycle cannot commit a receipt without adding a forbidden second
# R0 -> R1 tree delta; the checker authenticates clean HEAD and writes v3 here.
/docs/audits/first-party-constellation-v3.json

