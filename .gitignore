## Build
/dl/
/doc/
/inst/
/llvm/
/mingw-build/
/build
# Trust: the Spotlight-excluded home of `build/` — `build` is then a symlink to
# it (docs/BUILD_AND_INSTALL.md, "Keeping Spotlight out of build/"). `/build`
# above has no trailing slash, so it already matches that symlink.
/build.noindex
# A fresh tree's own Bootstrap, built outside build/ by scripts/build-tree-manager.sh
# so x.py has a native build-tree manager before build/bootstrap exists.
/build-tree-manager.noindex/
/build-rust-analyzer
/dist/
/unicode-downloads
/target
/library/target
/src/bootstrap/target
/src/tools/x/target
/targo-trust/target/
# `targo trust` writes its own bootstrap + dry-run scratch here. `/build` above is
# root-anchored so it never covered this one, and the directory is 500M+ of
# regenerable output that dirties the checkout — which blocks every gate that
# requires a clean tree (the falsification gate refuses to start on one).
/targo-trust/build/
crates/*/target/
# A benchmark crate outside the root workspace builds into its own target/. Unignored, its
# output would be an untracked source of every dev stage-1 build's identity (TB1).
/benchmarks/*/target/
tests/ui/trust/target/
examples/target/
# Created by `x vendor` — but NOT the repo's checked-in foreign vendored deps:
# vendor/rustc_version_0_4_1 (vendored crate) and vendor/lean-core-oleans (the
# Lean 4 core Init .olean closure + MANIFEST.toml consumed by the Lean↔Clean
# bridge gate, crates/trust-clean/src/trustir_bridge.rs — sha256-manifested,
# fail-closed; regenerate with scripts/regen-trustir-oleans.sh).
/vendor/*
!/vendor/rustc_version_0_4_1/
!/vendor/lean-core-oleans/
# Trust: maintained foreign Rust OpenSSL driver/caller; no bundled C copy.
!/vendor/openssl-src-trust/
!/vendor/openssl-sys/
# Legacy out-of-tree build root; still named in the workspace `exclude` list.
/obj/

