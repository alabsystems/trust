## Build
/dl/
/doc/
/inst/
/llvm/
/mingw-build/
/build
/build-rust-analyzer
/dist/
/unicode-downloads
/target
/library/target
/src/bootstrap/target
/src/tools/x/target
/targo-trust/target/
# `targo trust` writes its own bootstrap + dry-run scratch here. `/build` above is
# root-anchored so it never covered this one, and the directory is 500M+ of
# regenerable output that dirties the checkout — which blocks every gate that
# requires a clean tree (the falsification gate refuses to start on one).
/targo-trust/build/
crates/*/target/
tests/ui/trust/target/
examples/target/
# Created by `x vendor` — but NOT the repo's checked-in foreign vendored deps:
# vendor/rustc_version_0_4_1 (vendored crate) and vendor/lean-core-oleans (the
# Lean 4 core Init .olean closure + MANIFEST.toml consumed by the Lean↔Clean
# bridge gate, crates/trust-clean/src/trustir_bridge.rs — sha256-manifested,
# fail-closed; regenerate with scripts/regen-trustir-oleans.sh).
/vendor/*
!/vendor/rustc_version_0_4_1/
!/vendor/lean-core-oleans/
# Carcara Alethe checker, vendored byte-identical from ufmg-smite/carcara
# @ fecb4224 (v1.1.0); see [patch."https://github.com/ufmg-smite/carcara"].
!/vendor/carcara_1_1_0/
# ...but never in-place build junk from a cargo run inside the vendored workspace.
/vendor/carcara_1_1_0/target/
# Legacy out-of-tree build root; still named in the workspace `exclude` list.
/obj/

