[package]
name = "actual-pointer-parts-operational"
version = "0.0.0"
edition = "2021"
[workspace]
[lib]
path = "@TRUST_ROOT@/crates/trust-thir-lower/probes/pointer_parts_operational/replay.rs"
[dependencies]
clean-kernel = { path = "@TRUST_ROOT@/first-party/clean/crates/clean-kernel", features = ["math-overlays"] }
clean-olean = { path = "@TRUST_ROOT@/first-party/clean/crates/clean-olean" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
