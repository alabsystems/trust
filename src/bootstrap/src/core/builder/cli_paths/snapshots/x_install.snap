---
source: src/bootstrap/src/core/builder/cli_paths/tests.rs
expression: install
---
[Install] install::Docs
    targets: [aarch64-unknown-linux-gnu]
    - Set({src/doc})
[Install] install::Std
    targets: [aarch64-unknown-linux-gnu]
    - Set({library/std})
    - Set({rust-std})
    - Set({trust-std})
[Install] install::Rustc
    targets: [x86_64-unknown-linux-gnu]
    - Set({compiler/rustc})
    - Set({rustc})
    - Set({trustc})
[Install] install::LlvmTools
    targets: [x86_64-unknown-linux-gnu]
    - Set({trust-llvm-tools})
